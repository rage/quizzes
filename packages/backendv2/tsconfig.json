{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node", "jest"],
    "rootDir": ".",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "useDefineForClassFields": false,
    "isolatedModules": true
  },
  "exclude": ["node_modules", "dist"]
}
