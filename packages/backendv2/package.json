{
  "name": "backendv2",
  "version": "1.0.0",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "start": "node --import ./dist/instrument.js ./dist/server.js",
    "build": "tsc -p tsconfig.json",
    "ts-watch": "tsc --preserveWatchOutput -w -p tsconfig.json",
    "watch": "nodemon ./dist/server.js",
    "dev": "concurrently pnpm:ts-watch pnpm:watch",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test-open-conn": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles",
    "reset-test-db": "(dropdb quizzes_test || true) && createdb quizzes_test && cross-env NODE_ENV=test pnpm run migrate",
    "migrate": "pnpm run knex migrate:latest",
    "migration:make": "pnpm run knex migrate:make -x ts --migrations-directory database/migrations",
    "seed": "pnpm run knex seed:run --specific a.ts",
    "update-expired-courses": "node ./dist/bin/update-expired-courses.js",
    "background-producer": "node ./dist/bin/kafkaBackgroundProducer.js",
    "kafka-batch-publish": "node --max-old-space-size=2048 ./dist/bin/kafka-batch-publisher.js",
    "refresh-reaktor-view": "node ./dist/bin/refresh-reaktor-views.js",
    "typecheck": "tsc --noEmit",
    "knex": "node --import tsx ./node_modules/knex/bin/cli.js"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.7.0",
    "@sentry/node": "^11.10.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.27",
    "axios": "^1.21.0",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.9",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "koa": "^3.2.1",
    "koa-bodyparser": "^4.4.1",
    "lodash": "^4.18.1",
    "newrelic": "^14.10.0",
    "node-rdkafka": "^3.6.1",
    "objection": "~3.9.2",
    "pg": "^8.23.1",
    "pg-query-stream": "^4.17.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/koa": "^3.0.3",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa__cors": "^5.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "jest-extended": "^7.0.0",
    "knex-cleaner": "^1.3.1",
    "nock": "^14.0.17",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
