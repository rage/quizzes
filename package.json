    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.17.0"
